# ===== Motion Backend — copy thành .env rồi sửa =====

# Profiles bật khi `docker compose up` (và CI dùng cái này thay cho cờ --profile).
#   gpu   = chạy ComfyUI trong stack (cần GPU). proxy = Caddy HTTPS.
#   resource-admin = helper privileged nội bộ cho Admin VPS Monitor reset swap/drop cache thật.
#   VPS đích đầy đủ: COMPOSE_PROFILES=gpu,proxy
#   VPS muốn nút reset swap/cache thật: COMPOSE_PROFILES=gpu,proxy,resource-admin
#   Reuse ComfyUI sẵn có (vd 165): để TRỐNG + set COMFY_URL bên dưới.
COMPOSE_PROFILES=gpu,proxy

# Postgres (job store) — auto-setup, schema tự load lần đầu
POSTGRES_USER=motion
POSTGRES_PASSWORD=change-this-db-pass
POSTGRES_DB=motion

# MinIO (storage S3-compatible — giống Supabase Storage)
MINIO_ROOT_USER=motionminio
MINIO_ROOT_PASSWORD=change-this-minio-pass
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=motion
# Endpoint để client (FE) tải file qua presigned URL — đặt domain/host công khai của VPS:
S3_PUBLIC_ENDPOINT=http://YOUR_VPS_IP:9000
S3_REGION=us-east-1

# API NodeJS
API_PORT=8080
# Key cho app/FE gọi API (tạo/poll job). WORKER_TOKEN cho worker (nội bộ).
API_KEY=change-this-client-key
WORKER_TOKEN=change-this-worker-token
SIGNED_URL_TTL_SEC=604800       # 7 ngày
# Import URL Facebook/TikTok/YouTube trong Input node. setup.sh/Dockerfile cài yt-dlp mặc định.
YTDLP_BIN=yt-dlp
# Resolver dự phòng khi TikTok ẩn playAddr khỏi metadata web. Chỉ gọi sau khi
# yt-dlp direct + Chrome đều thất bại; có thể thay bằng resolver nội bộ.
SOCIAL_TIKTOK_RESOLVER_URL=https://www.tikwm.com/api/
# Khi chạy sau Caddy/HTTPS: đặt = https://<DOMAIN> → output_url tải qua API trên 1 domain (khỏi expose MinIO).
# Để TRỐNG nếu client tải trực tiếp từ MinIO bằng presigned URL (S3_PUBLIC_ENDPOINT).
# ALD 05/07/2026 - Biến này CHỈ còn phục vụ việc tạo link tải media (output_url), KHÔNG liên quan Social
# Management/Connect Facebook-TikTok nữa (xem block bên dưới) — domain dùng cho OAuth redirect giờ nhập
# riêng qua UI, không đọc biến này.
PUBLIC_BASE_URL=

# ── Social Management — Connect Facebook Page / TikTok (đăng tự động khi workflow ra kết quả) ──────
# ALD 05/07/2026 - App ID/Secret (Facebook), Client Key/Secret (TikTok), VÀ Public Base URL (domain HTTPS
# để 2 nền tảng redirect về sau khi cấp quyền) KHÔNG cấu hình bằng .env — CHỈ nhập qua UI: Social Management
# > nút "Hướng dẫn" (step-by-step), lưu hết vào bảng social_app_config (kể cả domain). Đây là chủ đích
# (không phải thiếu sót): mọi giá trị của luồng connect do người dùng tự nhập tay trong lúc dùng, không
# hardcode/đặt sẵn ở file server — kể cả PUBLIC_BASE_URL phía trên KHÔNG được dùng lại cho việc này (xem
# api/src/social-app-config.js). Muốn đổi App ID/Secret/Client Key/Secret/Public Base URL → vào lại UI đó,
# không sửa file này.

# HTTPS tự động (service caddy, chỉ chạy với --profile proxy)
DOMAIN=motion-server.datools.info

# ===== Auth (login OTP standalone — thay Supabase) =====
SESSION_JWT_SECRET=doi-thanh-chuoi-random-dai   # BẮT BUỘC đổi (ký JWT session)
ACCESS_TTL_SECONDS=3600       # access JWT 1h
REFRESH_TTL_SECONDS=2592000   # refresh 30 ngày
APP_NAME=Motions

# ── Admin gốc — BẮT BUỘC điền ──────────────────────────────────────────────
# Login CHỈ qua OTP và CHỈ email đã tồn tại trong DB mới đăng nhập được. Deploy mới bảng users
# rỗng → KHÔNG ai vào được & không tạo nổi admin đầu tiên. API tự tạo/nâng email này thành admin
# mỗi lần khởi động (idempotent — "ghim" quyền admin). Nhiều admin: ngăn cách bằng dấu phẩy.
# ĐỔI thành email của bạn trước khi chạy:
SUPER_ADMIN=doi-thanh-email-cua-ban@gmail.com

# ── SMTP gửi OTP — BẮT BUỘC để login email chạy ────────────────────────────
# Chọn ĐƯỜNG GỬI bằng cờ IS_USED_GMAIL:
#   true  → gửi qua Gmail (App Password); BỎ QUA toàn bộ OTP_SMTP_* bên dưới.
#   false → gửi qua SMTP thường (Mailgun / SendGrid / SES / nội bộ) ở OTP_SMTP_*.
IS_USED_GMAIL=true

# ── Đường 1: Gmail + App Password (dùng khi IS_USED_GMAIL=true) ──
#   1) Bật 2-Step Verification cho tài khoản Google.
#   2) Tạo App Password tại https://myaccount.google.com/apppasswords (mục "Mail") → chuỗi 16 ký tự.
#   3) Điền 2 dòng dưới — PASS là App Password (KHÔNG phải mật khẩu Gmail thường; space tuỳ ý, code tự bỏ).
#      From sẽ tự = GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Đường 2: SMTP thường / Mailgun (dùng khi IS_USED_GMAIL=false) ──
OTP_SMTP_HOST=
OTP_SMTP_PORT=587
OTP_SMTP_USER=
OTP_SMTP_PASS=
OTP_SMTP_FROM=
OTP_SMTP_FROM_NAME=Motions

# Worker
WORKER_ID=worker-1
POLL_INTERVAL_SEC=3
JOB_TYPES=motion,bds,tryon,create-image,product-overlay,teaser,video,text-to-video,ss,talk,face-motion,concat,story-film,subtitle,voiceover,wan-i2v,teen-flycam,trend-tiktok,enhance,reveal
INTERNAL_API_URL=http://api:8080

# ALD 14/06/2026 - "Model AI (custom)": thư mục uploads của ComfyUI (native trên host) bind-mount vào api để
# route /models ghi file model thẳng xuống đĩa (gom 1 nơi, dễ dọn). Đăng ký subdir qua extra_model_paths.yaml.
MODEL_UPLOADS_HOST_DIR=/home/ubuntu/ai/ComfyUI/models/uploads
MODEL_MAX_BYTES=32212254720

# Try-on giày/dép: bàn chân RẤT nhỏ trong ảnh full-body → render ở megapixel cao hơn cho rõ → áp được SP.
TRYON_SHOES_MP=2.0

# Create-image / tryon — Qwen-Image-Edit 2509 (khớp file tải theo comfyui/models.txt).
# Mặc định Q8_0 (~20GB, nét — tay/chi tiết tốt; vừa 5090 32GB). Nhẹ/nhanh hơn: Q5_K_M/Q4_K_M (sửa cả file tải).
QWEN_EDIT_GGUF=Qwen-Image-Edit-2509-Q8_0.gguf
# LoRA realism chống ảnh "render/hoạt hình" (file flymy_realism.safetensors tải theo models.txt). Để TRỐNG = tắt.
CREATE_IMAGE_LORA=flymy_realism.safetensors
# Steps render chính (25→30 mặc định: chi tiết tay/mặt/vải tốt hơn, đổi lại ~+20% thời gian). Hạ về 25 nếu cần nhanh.
CREATE_IMAGE_STEPS=30
# ── Detailer pass (vá tay/mặt) — chạy SAU render chính, best-effort (lỗi/không có mặt → giữ ảnh gốc) ──
# Face detailer: DWPose dò mặt → cắt hi-res → Qwen vẽ lại nét → ghép. Tắt = 0.
CREATE_IMAGE_FACE_DETAILER=1
CREATE_IMAGE_FACE_DENOISE=0.40   # mức vẽ lại mặt (0.3 giữ giống bản gốc hơn, 0.5 nét/đổi nhiều hơn)
# Hi-res refine TOÀN ảnh (đánh bóng chi tiết + tay nhờ thêm pixel). Tắt = 0.
CREATE_IMAGE_REFINE=1
CREATE_IMAGE_REFINE_DENOISE=0.30 # thấp = giữ bố cục/mặt; cao = vẽ lại nhiều (dễ trôi)
CREATE_IMAGE_REFINE_MP=2.5       # megapixel cho bước refine (cao hơn render chính 1.75MP)

# LTX-2.3 (Lightricks) — engine GENERATIVE ảnh+prompt → video+audio. Dùng cho Teaser (đặt motionMode=ltx
# trong config node) và job type 'video'. ⚠️ Node LTX-2.3 ra SAU training cutoff → worker KHÔNG đoán graph:
# PHẢI cấu hình LTX_WORKFLOW_JSON (đường dẫn file .json HOẶC chuỗi JSON) = "Save (API Format)" của workflow
# LTX-2.3 I2V chính thức xuất từ ComfyUI, trong đó thay giá trị động bằng token:
#   __IMAGE__ __PROMPT__ __NEG__ __WIDTH__ __HEIGHT__ __FRAMES__ __SEED__ __STEPS__ __FPS__ __MODEL__ __VAE__ __TEXT_ENCODER__ __PREFIX__
# Chưa set → Teaser tự fallback Ken Burns (không lỗi job). Tên model dưới phải khớp models.txt (Dev/Pro FP8).
# 🚨 VRAM: LTX-2.3 22B official = bf16 ~46GB > 32GB RTX 5090 → cần bản FP8/GGUF cộng đồng (~24GB) hoặc
#    block-swap/offload. Text-encoder = Gemma 3. Xem comfyui/models.txt. LTX_MODEL phải khớp tên file đã tải.
LTX_WORKFLOW_JSON=
LTX_MODEL=LTX-2.3-22B-distilled-1.1-Q6_K.gguf
LTX_VAE=
LTX_TEXT_ENCODER=
LTX_FPS=24
LTX_STEPS=8
LTX_TIMEOUT_SEC=1800

# node "SS" (Ảnh→Video LTX-2.3 22B + LoRA custom user tự train, chọn trong node SS). 3 file tải theo comfyui/models.txt:
#   SS_MODEL (UNET GGUF, đã có) · SS_GEMMA (text-encoder Gemma-3 fp8) · SS_VAE (VAE LTX rời).
# SS_WORKFLOW_JSON = đường dẫn file .json / chuỗi JSON 'Save (API Format)' của graph LTX-2.3 I2V xuất từ ComfyUI,
# thay giá trị động bằng token: __IMAGE__ __PROMPT__ __NEG__ __LORA__ __LORA_STRENGTH__ __WIDTH__ __HEIGHT__
# __FRAMES__ __SEED__ __STEPS__ __FPS__ __MODEL__ __GEMMA__ __VAE__ __PREFIX__. Chưa set → node SS báo lỗi rõ ràng.
SS_MODEL=LTX-2.3-22B-distilled-1.1-Q6_K.gguf
SS_GEMMA=comfy_gemma_3_12B_it.safetensors
SS_VAE=ltx-2.3-vae.safetensors
SS_CKPT=ltx-2.3-22b-distilled-1.1.safetensors
SS_WORKFLOW_JSON=
SS_FPS=24
SS_STEPS=8
SS_TIMEOUT_SEC=1800

# Worker macOS / Apple Silicon (chạy worker/worker_macos.py NATIVE — không qua Docker).
# useMacOS=true → ComfyUI dùng Metal/MPS: tự đổi model fp8→bf16, attention sageattn→sdpa.
# Để TRỐNG/không set: worker_macos.py auto-detect (true khi chạy trên macOS). Worker Linux bỏ qua biến này.
useMacOS=
# (tuỳ chọn, chỉ khi useMacOS) override model/precision MPS — để trống là dùng mặc định bf16+sdpa:
# WAN_ANIMATE_MODEL=Wan2_2-Animate-14B_bf16.safetensors
# WAN_BASE_PRECISION=bf16          # MPS: bf16 (fp16_fast/fp8 là CUDA)
# WAN_ATTENTION=sdpa               # MPS chỉ có sdpa
# QWEN_STEPS=20                    # giảm để nhanh hơn trên Mac (mặc định 25)
#
# ALD 24/06/2026 - setup/setup.sh TỰ set các biến dưới cho Mac (kiến trúc lai: backbone Docker + ComfyUI/worker
# native PM2). Liệt kê ở đây để biết — KHÔNG cần sửa tay nếu chạy setup.sh:
#   COMFY_DIR=$HOME/ComfyUI                               # nơi cài ComfyUI native
#   COMFY_MODELS_HOST_DIR=$HOME/ComfyUI/models            # FIX: bind-mount api (default Linux /home/ubuntu/... fail trên Mac)
#   MODEL_UPLOADS_HOST_DIR=$HOME/ComfyUI/models/uploads
#   COMFY_LOCAL=1                                         # bật app PM2 'comfyui' (ecosystem.config.cjs)
#   PYTORCH_ENABLE_MPS_FALLBACK=1                         # op MPS chưa hỗ trợ → fallback CPU (tránh crash)
#   MODEL_CATALOG_PLATFORM=macos                           # Models AI chỉ hiện model macOS/all, ẩn CUDA fp8
#   HIDE_QWEN_TRANSLATE_MODELS=1                          # ẩn Ollama qwen2.5 dịch prompt trong Models AI trên Mac
#   MACOS_QWEN_MODELS=1                                   # chỉ hiện/tải bộ Qwen Q4 + text-encoder GGUF cho MPS
#   CREATE_IMAGE_TRANSLATE=0                               # Qwen-Edit Mac không cần model dịch VN→EN mặc định
#   QWEN_EDIT_GGUF=Qwen-Image-Edit-2509-Q4_K_M.gguf
#   QWEN_CLIP=Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
#   MAC_MOTION_MAX_FRAMES=49                              # cap Motion MPS; tăng tay nếu máy đủ RAM/chấp nhận chậm
#   MAC_MOTION_MAX_SHORT=480
#   WORKER_SCRIPT=worker_macos.py
# JOB_TYPES Mac mặc định (native, nhẹ): create-image,product-overlay,tryon,teaser,subtitle,concat
#   thêm GPU MPS best-effort: text-to-video,ss,enhance,bds,motion
#   KHÔNG chạy native (cần CUDA fp8 14B): talk,face-motion,story-film → để box Linux.

# Vision auto-detect loại đồ cho Try-on (tự nhận áo/quần/váy/set/bikini/bra/đồ-lót/giày/phụ-kiện khi để Auto).
# Cần 1 Ollama có model vision. TRỐNG = TẮT auto-detect → Try-on dùng loại chọn tay (mặc định 'upper').
OLLAMA_URL=                      # vd http://172.17.0.1:11434 (Ollama trên host) hoặc http://<ip-box>:11434
VISION_MODEL=qwen2.5vl:7b        # phải `ollama pull` sẵn trên host trên; nhẹ, tự unload ngay sau khi nhận diện
# Model phân tích kịch bản → tự dựng workflow node (nút "Dựng workflow từ kịch bản"). Phải `ollama pull` sẵn.
# Tự unload khỏi VRAM ngay sau khi dựng xong nên KHÔNG giữ GPU cho bước sau.
#   - qwen3.6:35b  → tool-use/agentic tốt nhất, ~24GB VRAM (nặng trên RTX 5090 32GB nhưng xả ngay sau khi xong).
#   - qwen2.5:32b-instruct → cân bằng. qwen2.5:7b-instruct → nhẹ/nhanh, hợp khi GPU đang bận.
WORKFLOW_AI_MODEL=qwen3.6:35b
# (Bật "suy luận sâu" của qwen3.x KHÔNG cấu hình ở đây — FE quyết định theo từng lần dựng qua toggle trong modal.)

# ComfyUI
COMFY_PORT=8188
# Trong stack (--profile gpu): để mặc định http://comfyui:8188
# Dùng ComfyUI sẵn có bên ngoài: set URL của nó + KHÔNG chạy --profile gpu, vd:
#   - ComfyUI chạy trên CHÍNH host VPS:   COMFY_URL=http://host.docker.internal:8188
#   - ComfyUI ở máy/box khác:             COMFY_URL=http://<ip>:8188
COMFY_URL=http://comfyui:8188
# RTX 5090/Wan: setup native tự verify SageAttention rồi ghi giá trị này; Docker đã cài sẵn.
MOTION_ATTENTION=sageattn
# PyTorch 2.12+: allocator native dạng expandable giảm phân mảnh với workflow/video có kích thước thay đổi.
PYTORCH_ALLOC_CONF=expandable_segments:True
CUDA_MODULE_LOADING=LAZY
# Baseline đã đo vừa VRAM 32GB: 540p/≤250 frame chạy model trên GPU; job lớn hơn tự block-swap qua RAM.
MOTION_SHORT=540
MOTION_VRAM_MAX_EDGE=968
MOTION_VRAM_MAX_FRAMES=250
# Chỉ bật khi chạy nhiều job cùng kích thước và không recycle ComfyUI liên tục; lần đầu compile tốn thời gian/VRAM.
MOTION_TORCH_COMPILE=0
# Bật khi COMPOSE_PROFILES có resource-admin: ADMIN_RESOURCE_HELPER_URL=http://resource-helper:8099
# Để trống nếu không muốn cấp quyền host cho helper.
ADMIN_RESOURCE_HELPER_URL=
ADMIN_RESOURCE_HELPER_TOKEN=change-this-resource-helper-token
ADMIN_RESOURCE_COMMAND_TIMEOUT_MS=120000
ADMIN_INSPECT_COMMAND_TIMEOUT_MS=3000
# Drawer log trên canvas và /admin/vps. Native PM2 tự dò $PM2_HOME/logs;
# Docker API mount thư mục host này vào /host-pm2-logs (đổi nếu PM2 chạy user khác ubuntu).
PM2_LOG_DIR_HOST=/home/ubuntu/.pm2/logs
COMFY_PM2_LOG_DIR=/host-pm2-logs
HF_TOKEN=                        # (optional) token HuggingFace để tải models nhanh/đủ quyền
