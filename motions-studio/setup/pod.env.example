# ════════════════════════════════════════════════════════════════════════════
# pod.env.example — env override cho quy trình dựng pod trên Network Volume.
#
# File THẬT nằm trên volume, MỘT file cho MỖI tenant:
#     /workspace/tenants/<tenant>/pod.env
# pod-up.sh nạp nó ở bước 2. File này chỉ là bản mẫu (mọi giá trị bí mật để trống).
#
#     cp setup/pod.env.example /workspace/tenants/vanhoang/pod.env
#     # sửa lại, rồi:
#     ./setup/pod-up.sh vanhoang
#
# Xem thiết kế đầy đủ: docs/superpowers/specs/2026-07-31-toi-uu-khoi-tao-pod-design.md
# ════════════════════════════════════════════════════════════════════════════

# ── Tenant ──────────────────────────────────────────────────────────────────
# Trùng tên thư mục trong /workspace/tenants/ VÀ tên mẫu trong templates.json.
TENANT=khach-mau

# ── Nguồn cấu hình ──────────────────────────────────────────────────────────
# Template CỦA BẠN, nằm trên volume, không bao giờ vào git.
TEMPLATES_FILE=/workspace/secrets/templates.json

# Chặn gọi Motion Task Cloud API của bên khác.
# KHÔNG dùng SETUP_API_KEY="" — ${VAR:-default} coi chuỗi rỗng như chưa set nên
# nó sẽ rơi về key mặc định trong fullstack-setup.sh.
SETUP_API_URL=http://127.0.0.1:1

# ── Đường dẫn trên volume ───────────────────────────────────────────────────
# Repo frontend: clone từ mirror cục bộ → nhanh, không cần mạng, không phụ thuộc
# quyền đọc repo nào. Tạo mirror một lần từ monorepo này:
#   git clone --mirror git@github.com:doanhthuc/motion-clone.git \
#     /workspace/shared/mirrors/motions.git
MOTIONS_REPO=/workspace/shared/mirrors/motions.git
MOTIONS_DIR=/workspace/tenants/khach-mau/motions

# Model Ollama dùng chung mọi tenant.
OLLAMA_MODELS=/workspace/shared/ollama-models

# ── Bỏ các bước tải lại ─────────────────────────────────────────────────────
# Model đã nằm trên volume, symlink vào $HOME/ComfyUI/models.
SKIP_MODELS=1
SKIP_OLLAMA_MODELS=1

# Bỏ npm run build của frontend khi .output/ đã có sẵn trên volume và code FE
# không đổi. MẶC ĐỊNH TẮT: bỏ build sau khi đã sửa code FE là loại lỗi rất khó
# nhận ra. Chỉ bật khi bạn chắc chắn.
# SKIP_FE_BUILD=1

# ── Ngưỡng cho bước kiểm chứng ──────────────────────────────────────────────
# pod-up.sh dừng nếu tổng dung lượng comfy-models nhỏ hơn ngưỡng này — dấu hiệu
# symlink đang trỏ vào thư mục rỗng. Đặt theo bộ model thật của bạn.
MODELS_MIN_GB=40
