.env
.env.*
!.env.example
*.log

# Python cache của scripts/ orchestration
__pycache__/
*.pyc

# Scratch workspace for superpowers:subagent-driven-development (ledgers,
# briefs, review packages) — not part of the shipped repo.
.superpowers/

# Isolated feature branches created by the implementation-plan workflow.
.worktrees/

# Bản theo dõi upstream nằm NGOÀI repo (~/Desktop/motion-upstream-tracking/)
# — liệt kê ở đây để nếu ai đó copy vào trong thì cũng không lọt vào git.
motions-studio-upstream/
motions-upstream/

# Ảnh/video cho gpu-smoke lớp 6. KHÔNG commit: repo này public và đây là media cá nhân.
.smoke/

# macOS junk
.DS_Store
ab-results/

# batch runner — material và kết quả là dữ liệu cá nhân, không vào repo public
out/
batch/*.yaml
!batch/example.yaml
batch/*.state.json
# MCP server ghi pid/argv/log/mã thoát của lượt chạy nền cạnh manifest (*.mcp.json,
# *.mcp.log, *.mcp.rc). Dữ liệu của máy này, không của repo.
batch/*.mcp.*
# Pod lease written by drain.py/watchdog — machine state about a rented pod, not repo content.
batch/pod-lease.json
# The same thing for a volume migration's two TEMPORARY CPU pods
# (scripts/volume_migrate.py). Its own file, so its own line: the pattern above
# is an exact name, not a glob, and does not cover this one.
batch/volume-migrate-lease.json
# The bot's marker for a migration it has launched but whose lease has not been
# written yet (tgbot/bot.py _migrate_launch_marker).
batch/volume-migrate.launching.json
# Per-machine history of Vast rentals (scripts/vast_rent.py): what each host actually did.
batch/vast-machines.json
# Which message the bot keeps edited for a migration. NOT covered by
# `batch/*.progress.json` above — that glob needs a literal ".progress.json"
# and this suffix is "-progress.json" — and the filename embeds the user's
# Telegram chat id, which is exactly the kind of thing a public repo must not
# grow by accident.
batch/*.migrate-progress.json
# Run logs written beside a manifest: `<manifest>.drain.log` (tgbot/run.py
# start_drain) and batch/volume-migrate.log (bot _start_migration). Output of a
# machine's own runs, and a drain log quotes material paths.
batch/*.log
# bản nháp job của bot Telegram — chứa đường dẫn material cá nhân
batch/*.draft.json
# job vừa gửi, giữ lại cho /again — cùng lý do như draft
batch/*.last.json
# tin nhắn tiến độ đang được sửa tại chỗ
batch/*.progress.json
# draft không đọc được, dọn sang một bên để còn dựng lại tay
batch/*.json.bad
# DraftStore's own corrupt/atomic-write files are named
# `<owner>.draft.json.<hex>.bad` / `.tmp` (control/drafts.py _load/_save) — the
# hex suffix means they don't end in ".json.bad", so the glob above misses
# them; these two catch the actual on-disk names.
batch/*.bad
batch/*.tmp
# make batch-validate's throwaway manifests (control/drafts.py validate()) —
# never a run, never referenced once the request answers.
batch/.validate/
# /wipe's per-chat message-id ledger — tracks the user's own chat history
batch/*.ledger.json
# Per-chat records tgbot/bot.py writes beside the manifest as
# `tg-<chat_id>.<name>.json`: the last kill's outcome (_kill_result_path, so
# GET /v1/pod can answer across a restart) and the draft generation an app
# confirm was accepted at (_confirm_stamp_path, so resume can refuse a draft
# that moved since). Both are machine state and both embed the user's Telegram
# chat id — exactly what a public repo must not grow by accident — and on the
# VPS this path is inside the repo working tree, so they would otherwise show
# up in `git status`, one `git add .` away from a public commit. NOT covered by
# `batch/*.last.json` above: that glob needs a literal ".last.json" and these
# suffixes are ".last-kill.json" and ".confirmed-generation.json". Their `.tmp`
# siblings from the atomic write are already caught by `batch/*.tmp`.
batch/*.last-kill.json
batch/*.confirmed-generation.json
# Three more per-chat records with the same shape and the same hazard, found
# 2026-09-24 while verifying the PR #68 deploy: `git status` on the VPS showed
# tg-<chat_id>.gpusubs.json and tg-<chat_id>.handoff.json untracked, in a public
# repo, with a Telegram chat id in the filename. `.gpusubs.json` is
# bot.py:4338; `.handoff.json` is batchlib_ext/handoff.py:30 and inherits the
# chat id from the manifest name rather than a literal, which is why grepping
# for `tg-{chat_id}` does not find it. `.provision-failed.json`
# (batchlib_ext/provision_failure.py:16) is transient — clear_provision_failure
# consumes it — but it exists exactly when a rental has failed, which is when
# someone is most likely to be poking at the tree. `migrate-resume.json` and the
# `idempotency/` directory carry no chat id (idempotency keys are sha256-hashed
# at control/idempotency.py:34) but are machine state all the same. Enumerated
# by listing every `batch/` path the code constructs and running
# `git check-ignore` on each, rather than by reading this file's patterns.
batch/*.gpusubs.json
batch/*.handoff.json
batch/*.provision-failed.json
batch/migrate-resume.json
batch/idempotency/

# IDE junk — repo public, config cá nhân không vào đây (cùng lý do .DS_Store)
.idea/

# Telegram bot API — local secrets. The server's storage moved out of the repo
# entirely on 2026-08-31: it is now bind-mounted at /var/lib/telegram-bot-api on
# both sides (scripts/vps/telegram-bot-api.yml), because getFile returns a
# container path that bot.py has to be able to open on the host. Nothing under
# scripts/vps/ holds media any more.
scripts/vps/bot-api.env

# Uploads the Telegram bot accepted, copied out of the Bot API server's storage
# (bot.py:STAGING_DIR_NAME). Personal media, and the paths it replaces contain
# the bot token — neither belongs in a public repo.
batch/tg-staging/
# The phone API's upload chunks and thumbnail cache (control/uploads.py, materials.thumbnail).
# Personal media, like tg-staging/ above.
batch/uploads/
batch/thumbs/
# The try-on library's index and its saved images (control/tryon_library.py).
# The user's own photographs, kept on purpose across runs — on the VPS this
# path is inside the repo working tree, so it would otherwise show up in
# `git status` and be one `git add .` away from a public commit.
batch/tryon-library/

# Downscaled JPEGs the bot builds so a slot question can be answered by eye
# (tgbot/preview.py). Throwaways, but they are still the user's own photographs
# and this repo is public.
batch/tg-preview/
