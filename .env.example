# =========================================================
# motion-clone root config — GPU pod rental + motions-studio deploy.
# Copy: cp .env.example .env, rồi điền giá trị thật. KHÔNG commit .env (đã .gitignore).
# =========================================================

# --- Rented GPU pod (vast.ai / RunPod) ------------------------------------
# vast | runpod — chọn CLI mà make gpu-provision/gpu-up/gpu-down dùng.
GPU_PROVIDER=runpod

# GPU_PROVIDER=runpod: gpu-id dạng tên đầy đủ (thấy trong lệnh `runpodctl pod create --gpu-id ...`
#   mà pod-provision.sh in ra ở dry-run) — KHÔNG phải cú pháp gạch dưới của vast.
# GPU_PROVIDER=vast: đổi sang filter của vast.ai search (motion-transfer box, xem
#   motions-studio/DEPLOY.md) — tối thiểu 24GB (RTX_4090), khuyến nghị 32GB (RTX_5090), vd GPU=RTX_5090.
GPU=NVIDIA GeForce RTX 5090
DISK=120
# MAX_DPH và RELIABILITY chỉ dùng cho nhánh tìm offer của vast.ai. RunPod không đấu giá nên
# pod-provision.sh bỏ qua cả hai — giữ lại phòng khi quay về vast.
MAX_DPH=0.60
RELIABILITY=0.95

# Lưới an toàn chống quên tắt pod: sau bao nhiêu giờ pod TỰ DỪNG (runpodctl --stop-after).
# Pod GPU là $0,99/giờ, nên một lần quên tắt để chạy cả tháng là ~$713. Với POD_MAX_HOURS=8 thì
# một lần quên tốn ~$8.
# DỪNG chứ không XOÁ, và đây vẫn là lựa chọn có chủ ý — nhưng LÝ DO đã đổi từ 07/08/2026.
# Lý do CŨ (nay sai): "terminate xoá container disk → mất database". Không còn đúng: pod-pgdump.sh
# dựng lại DB từ bản pg_dump trên volume (docs/gpu-pod.md#pg-backup).
# Lý do THẬT bây giờ: --terminate-after là RunPod tự xoá pod, KHÔNG chạy hook nào của ta, nên không
# có lần dump cuối. Bản dump gần nhất là lần bạn chủ động chạy `make gpu-down` / `gpu-db-dump` —
# có thể là phiên trước. Còn --stop-after chỉ dừng pod, dữ liệu còn nguyên, bật lại rồi dump là đủ.
# Lưới này chỉ nổ khi bạn QUÊN, mà quên là đúng lúc tệ nhất để mất metadata.
# Đổi lại: pod đã dừng VẪN tính tiền container disk. Lưới chặn khoản đắt ($0,99/giờ GPU), không
# chặn hết. Dọn hẳn vẫn là `make gpu-destroy` — và từ nay đó là THÓI QUEN mặc định khi xong việc,
# không phải thao tác đặc biệt: xem docs/gpu-pod.md#destroy-first.
# 0 = tắt lưới. KHÔNG áp được cho COMPUTE_TYPE=cpu (REST /v1/pods không có field auto-stop).
POD_MAX_HOURS=8

# Sàn phần cứng khi tìm offer vast (RunPod bỏ qua — máy datacenter đồng đều).
# vast là chợ máy của người khác: đo 01/08/2026 trên 64 offer RTX 5090, disk_bw chạy từ 395 đến
# 12800 MB/s — chênh 32 lần ở CÙNG con GPU. Mà setup gần như toàn I/O + CPU (apt Postgres, giải nén
# ~3-4GB torch, 6 custom node + pip deps). Đĩa chậm = setup 1-2 TIẾNG thay vì 10-20 phút.
# Không có hai ngưỡng này thì script sort theo giá rẻ nhất, tức là chọn đúng máy chậm nhất.
MIN_DISK_BW=3000
MIN_CPU_GHZ=2.5

# POD_IMAGE — bỏ trống thì pod-provision.sh tự chọn theo provider (runpod/pytorch cho GPU,
#   runpod/base cho CPU). Với MTC_PREBUILT=1 thì BẮT BUỘC điền, và GHIM TAG sha-<commit>:
#   `latest` trôi theo main, pod dựng lại tuần sau sẽ khác image mà không ai đổi gì.
#   vd: ghcr.io/<owner>/motion-prebuilt:sha-a1b2c3d
# Nếu để trống: torch của image KHÔNG được dùng (ComfyUI có venv riêng), nhưng CUDA khai báo
# trong tag ảnh hưởng host bạn được xếp lên. Mặc định pin cuda13.0 để khớp nhánh cu130 mà
# lib-gpu.sh nhắm tới — nhánh đó cần driver R580+. Xem docs/gpu-pod.md#cuda-13.
POD_IMAGE=

# --- Điền sau khi `make gpu-provision CONFIRM=yes` rent xong (hoặc để make gpu-wait tự điền) ---
GPU_INSTANCE_ID=
GPU_SSH_HOST=
GPU_SSH_PORT=
GPU_HOURLY=0.40

# --- Deploy config — truyền thẳng vào setup/setup-motion-transfer.sh trên pod -----------
# Domain THẬT bạn quản lý trên Cloudflare (không kèm https://). Bắt buộc nếu không dùng SKIP_HTTPS.
DOMAIN=motion-transfer.yourdomain.com
# Email admin đầu tiên — BẮT BUỘC, là email duy nhất login được sau khi deploy xong.
SUPER_ADMIN=you@example.com
# OTP qua Gmail App Password (https://myaccount.google.com/apppasswords, cần bật 2FA). Bỏ trống = cấu hình SMTP sau.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Cloudflare API Token: cần đủ 3 quyền Account·Cloudflare Tunnel:Edit + Zone·DNS:Edit + Zone·Zone:Read.
# Xem docs/gpu-pod.md#cloudflare-api-token. Cần CF_API_TOKEN HOẶC CF_TUNNEL_TOKEN (không cần cả 2).
CF_API_TOKEN=
# Thay thế cho CF_API_TOKEN: token của 1 tunnel CÓ SẴN (vd tái dùng từ project khác) — bán tự động,
# CẦN 1 bước thủ công trên Cloudflare dashboard sau khi deploy. Xem docs/gpu-pod.md#reusing-an-existing-tunnel-token.
CF_TUNNEL_TOKEN=
# Origin nào được gọi API. Ngăn cách bằng dấu phẩy. Bật FE trên pod (FE_DOMAIN bên dưới) thì
# PHẢI thêm https://<FE_DOMAIN> vào đây — thiếu nó FE vẫn load bình thường nhưng MỌI API call
# chết CORS, triệu chứng trông y hệt backend hỏng. make gpu-preflight chặn trường hợp này.
#   ví dụ khi chạy cả hai:  CORS_ORIGINS=https://app.yourdomain.com,http://localhost:2030
CORS_ORIGINS=http://localhost:2030

# --- Frontend chạy TRÊN POD (tuỳ chọn) — end-user chỉ mở 1 link, không cần máy bạn bật ------
# Đặt FE_DOMAIN thì `make gpu-bootstrap` sẽ:
#   • thêm hostname thứ hai vào CÙNG Cloudflare Tunnel: FE_DOMAIN → localhost:FE_PORT
#     (setup-pm2.sh tự tạo cả ingress lẫn DNS record — cần CF_API_TOKEN, không phải CF_TUNNEL_TOKEN)
#   • rsync motions/ lên pod, npm install + build TẠI POD, chạy dưới PM2 tên "motions"
# Sau đó sửa code FE thì chỉ cần `make gpu-fe` (~2 phút) thay vì bootstrap lại toàn bộ.
# Bỏ trống = giữ nguyên cách cũ: backend trên pod, frontend chạy local bằng `make dev`.
#
# FE_DOMAIN phải KHÁC DOMAIN. Cả hai nên cùng zone Cloudflare để 1 token là đủ quyền;
# khác zone thì token phải có Zone·DNS:Edit trên cả hai và hai zone phải cùng account.
FE_DOMAIN=
FE_PORT=2030
# FE_BUILD — build frontend Ở ĐÂU:
#   ci   (mặc định) tải .output build sẵn từ artifact của .github/workflows/build-frontend.yml rồi
#        rsync lên pod. Pod KHÔNG npm install, KHÔNG build → đỉnh RAM về 0 và `make gpu-fe` từ
#        ~2-4 phút xuống ~15 giây. ĐÒI HỎI: `gh` đã login, và commit hiện tại đã push + CI xong.
#        Nếu motions/ có thay đổi chưa commit thì script CHẶN — artifact build từ commit nên nó
#        không chứa các thay đổi đó, deploy ra bản khác cái bạn đang sửa là lỗi rất khó thấy.
#   pod  build trên pod như trước. Đường thoát khi đang sửa FE mà chưa muốn push.
#        Cần RAM: build đo được đỉnh 2,49 GB, cộng ~0,7 GB của Postgres/MinIO/api đang chạy.
# Vì sao CI được mà máy dev thì không: nitro NHÚNG sharp vào .output/server/node_modules/@img/.
# Build trên macOS ra sharp-darwin-arm64 → copy sang pod Linux là chết. ubuntu-latest là linux-x64.
FE_BUILD=ci

# --- Network Volume + image dựng sẵn — HAI THỨ CẮT THỜI GIAN DỰNG POD -------------------
# Không đặt hai biến này thì mỗi lần dựng pod bạn mất ~20-35 phút cài phần mềm CỘNG với
# ~33GB tải model trong app, và database mất sạch mỗi lần Stop/Start pod.
#
# POD_VOLUME: đường mount của RunPod Network Volume trên pod. Đặt vào đây thì
# scripts/pod-bootstrap.sh sẽ symlink models + PGDATA + MinIO sang volume trước khi chạy
# setup → pod mới KHÔNG tải lại model và KHÔNG mất DB.
# Volume phải được attach lúc TẠO pod, và phải CÙNG REGION với pod.
# Bỏ trống = tắt (giữ nguyên hành vi cũ). Xem docs/gpu-pod.md#network-volume.
POD_VOLUME=
# Ngưỡng cảnh báo: dưới mức này thì pod-volume.sh coi là symlink đang trỏ thư mục rỗng.
# Đặt theo bộ model thật của bạn (bộ Wan 2.2 Animate ~33GB).
MODELS_MIN_GB=20
# Id volume để runpodctl attach lúc tạo pod. Để trống: pod-provision.sh tự lấy nếu bạn chỉ có
# đúng 1 volume, và tự ghim pod vào datacenter của volume (khác datacenter là không mount được).
POD_VOLUME_ID=
# Số bản dump database giữ lại trên volume (setup/pod-pgdump.sh). Dump là metadata thuần,
# cỡ vài MB, nên giữ nhiều gần như miễn phí. Đặt 1 cũng KHÔNG xoá sạch: script không bao
# giờ xoá bản cuối cùng còn lại.
# Đọc ở đây (máy dev) rồi Makefile truyền qua ssh cho pod ở gpu-down / gpu-destroy /
# gpu-db-dump — pod KHÔNG có file này (rsync loại trừ .env*), nên bỏ trống = mặc định 20.
PG_DUMP_KEEP=20
# --min-cuda-version cho `runpodctl pod create`. 13.0 = chỉ nhận host driver R580+, để lib-gpu.sh
# đi nhánh cu130 + torch 2.12.1 thay vì tụt xuống cu128. Xem docs/gpu-pod.md#cuda-13.
MIN_CUDA_VERSION=13.0
#
# MTC_PREBUILT=1 → boot từ image dựng sẵn (POD_IMAGE), bỏ ~20-35 phút cài apt/Node/torch/ComfyUI.
#   BẮT BUỘC đi kèm POD_IMAGE trỏ vào image do .github/workflows/build-prebuilt-image.yml dựng.
#   Thiếu /opt/mtc-prebuilt/.ready trong image là setup `die` ngay (phase_prebuilt_deps() trong
#   setup/lib-feature.sh) — cố ý, để bạn không âm thầm rơi về đường cài-từ-đầu mà không biết.
#   Để 0 nếu dùng image runpod/pytorch trần.
MTC_PREBUILT=0

# --- Hình dạng deploy: cài gì, và ai chạy job --------------------------------------------
# Ba câu hỏi độc lập, ba biến.
#
# COMPUTE_TYPE — box thuê có GPU hay không (chỉ RunPod; vast.ai không bán máy CPU thuần):
#   gpu  (mặc định) pod có GPU. Dùng được worker local — job chạy ngay, không cold start, và
#        KHÔNG tốn thêm đồng nào vì GPU đã trả theo giờ. $0,99/giờ cho RTX 5090.
#   cpu  box KHÔNG GPU: chỉ Postgres + MinIO + api + frontend. Job render đi qua RunPod
#        Serverless. Đo 04/08/2026: $0,06/giờ ở 2 vCPU, Network Volume mount được ở EU-RO-1.
#        BẮT BUỘC đi kèm SETUP_PROFILE=cpu-box và WORKER_SOURCE=serverless.
#
# CHỌN CÁI NÀO: câu hỏi không phải "bao nhiêu job" mà "GPU có rỗi không".
#   Serverless đắt hơn pod 1,33-1,58× cho MỖI GIÂY GPU — nó chỉ tính $0 khi rỗi.
#   Bật máy theo phiên, job chạy nối nhau (GPU bận ~100%)  → gpu + local RẺ HƠN 2-3 lần.
#   App bật 24/7 cho người dùng thật, dưới ~79 job/ngày     → cpu + serverless rẻ hơn.
#   Trên ~79 job/ngày (≈51% GPU bận)                        → quay lại gpu + local.
# Bảng đầy đủ: docs/gpu-pod.md#deploy-shapes
COMPUTE_TYPE=gpu
# Chỉ dùng khi COMPUTE_TYPE=cpu. RAM = CPU_VCPU × hệ số flavor (c=×2 · g=×4 · m=×8).
# Giá đo thật 04/08/2026: cpu3c×2 (4GB) $0,06 · cpu5c×2 (4GB) $0,07 · cpu5c×4 (8GB) $0,14 ·
# cpu5g×4 (16GB) $0,184 — mỗi giờ. Mặc định cpu5c×4 = 8 GB, $101/tháng.
# Vì sao 8 GB chứ không 4: `npm run build` của Nuxt đo được đỉnh 2,49 GB, và lúc build thì
# Postgres/MinIO/api đã chạy chiếm ~0,7 GB → 3,2 GB, tức 80% trần của box 4 GB. Chạy ổn định
# (không build) chỉ dưới 1 GB — toàn bộ PM2 đo được 311 MB. Xem docs/gpu-pod.md#box-cpu-ram.
# Hai biến này chỉ có đường REST mới đặt được — runpodctl pod create không có cờ nào cho chúng,
# nên nhánh cpu trong pod-provision.sh gọi REST /v1/pods thay vì runpodctl.
CPU_FLAVOR=cpu5c
CPU_VCPU=4
#
# SETUP_PROFILE — box cài gì (pod chạy motions-studio/setup/setup-<profile>.sh):
#   cpu-box          box KHÔNG GPU: chỉ minio,api,wf-worker. Bỏ comfyui/worker/task-cloud-auto
#                    (cả ba đòi GPU; task-cloud-auto crash-loop nếu để lại). Đi với COMPUTE_TYPE=cpu.
#   motion-transfer  (mặc định) 4 type Wan · catalog KHOÁ vào model Wan Animate · không Ollama.
#                    Ít thứ để hỏng nhất, cài nhanh nhất.
#   full             21 type · catalog KHÔNG lọc (thêm Qwen-Image-Edit, Flux, LTX-2.3) ·
#                    có Ollama + bg-remover. Chọn cái này nếu bạn cần tạo ảnh / tryon / dịch.
#   create-image · tryon   box chuyên khác — xem motions-studio/setup/README.md
SETUP_PROFILE=motion-transfer
#
# JOB_TYPES_OVERRIDE — thu hẹp JOB_TYPES so với những gì SETUP_PROFILE khai. Chỉ CẮT BỚT được,
#   type ngoài profile là cổng chặn `die` (thiếu custom node thì worker chết ở /prompt, không
#   phải chỉ thiếu model). Dùng khi volume chưa có model cho hết số type profile hỗ trợ:
#   worker không claim job nó không chạy nổi, thay vì nhận rồi set error.
#   Bỏ trống = dùng nguyên JOB_TYPE của profile.
JOB_TYPES_OVERRIDE=
#
# WORKER_SOURCE — ai claim job:
#   local       worker trên pod. GPU pod đã trả tiền theo giờ rồi nên worker này KHÔNG tốn thêm,
#               và job chạy ngay (không có cold start 1-3 phút). Dispatcher không bật.
#   serverless  dừng worker local, RunPod Serverless claim. Trả theo giây GPU thực dùng.
#               ĐÒI HỎI: image serverless phải bake đủ JOB_TYPES mà box claim được — xem
#               DISPATCH_JOB_TYPES bên dưới. Không khớp thì job nằm queued vĩnh viễn.
#   both        cả hai cùng chạy. CHỈ hợp lý khi hai bên nhận nhóm type RỜI NHAU, ví dụ pod gánh
#               create-image/tryon còn serverless gánh 4 type Wan nặng.
# Bỏ trống = suy ra như trước: có đủ RUNPOD_* → serverless, không thì local.
# Với COMPUTE_TYPE=cpu thì `local` bị CHẶN: box không có GPU mà job giao cho worker local nghĩa là
# không ai chạy được job nào — và không có triệu chứng gì, box vẫn lên xanh, job nằm queued mãi.
WORKER_SOURCE=

# --- RunPod Serverless (tuỳ chọn) — không có task = không tốn tiền GPU -------------------
# Cần khi WORKER_SOURCE=serverless hoặc both: make gpu-bootstrap dựng thêm tiến trình
# mc-dispatcher, nó poll bảng jobs và đánh thức worker serverless khi có job queued.
# Endpoint PHẢI cùng datacenter với Network Volume (POD_VOLUME_ID ở trên) — gắn volume khoá
# endpoint vào đúng datacenter đó. RunPod mount volume ở /runpod-volume CỐ ĐỊNH cho Serverless
# (template Serverless không có ô "Volume Mount Path" như template Pod).
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Trần số worker đánh thức cùng lúc. Mỗi worker là một cold start ~1-3 phút, nên đặt cao không
# làm nhanh hơn mà chỉ tốn hơn. Đây là trần TỔNG số /run còn trong cửa sổ cooldown, không phải
# trần mỗi vòng poll.
DISPATCH_MAX_INFLIGHT=3
# Danh sách job type dispatcher chịu trách nhiệm đánh thức. PHẢI khớp JOB_TYPES bake trong image
# (worker/runpod/Dockerfile.selfhosted) VÀ JOB_TYPES của Endpoint. Bỏ trống = dùng mặc định
# trong mc-dispatcher.js (4 type Wan — khớp image bản `motion`).
# Lệch nhau thì hoặc job nằm queued vĩnh viễn, hoặc worker claim job nó không chạy được rồi đặt
# error. Dùng image bản `full` (tag :latest-full) thì mở danh sách này cho khớp; pod-bootstrap.sh
# có cổng cảnh báo khi JOB_TYPES của pod có type mà dispatcher không gửi đi.
DISPATCH_JOB_TYPES=
# Sau bao nhiêu giây IM LẶNG thì coi một job 'running' của worker serverless là mồ côi và chuyển
# sang 'error'. Cần có vì cơ chế reclaim sẵn có bám theo worker_id, mà mỗi container serverless có
# id riêng nên nó không bao giờ kích hoạt → job treo 'running' vĩnh viễn.
# Im lặng = KHÔNG có PATCH tiến độ VÀ KHÔNG có heartbeat, cả hai cùng lúc.
# Đo thật 02/08/2026: im lặng dài nhất trong lúc job chạy là 79s (pha tải input / nạp model /
# upload output không nhịp gì cả). Job 1080p upload lâu hơn nên còn dài hơn.
# Mặc định 900. Sàn cứng 300 — đặt thấp hơn sẽ bị kéo lên, vì đặt hụt là GIẾT job đang chạy thật
# và mất luôn tiền GPU đã trả. Đặt 0 để tắt hẳn.
DISPATCH_ORPHAN_SEC=900
# Nhịp poll bảng jobs, giây. Mặc định 5, sàn 2.
DISPATCH_POLL_SEC=
# Sau khi bắn /run thì bao lâu mới được bắn tiếp cho cùng lượng việc đó, giây. Mặc định 180, PHẢI
# ít nhất bằng cold start thật (đo 02/08/2026: ~155s) — thấp hơn thì dispatcher bắn lại mỗi vòng
# poll suốt cold start, và một job queued duy nhất kéo cả max workers lên.
DISPATCH_COOLDOWN_SEC=

# Cả năm biến DISPATCH_* trên chỉ có hiệu lực nhờ pod-bootstrap.sh chuyển tay chúng sang PM2 —
# `pm2 start <script>` không đọc file .env nào cả. Trước 03/08/2026 nó KHÔNG chuyển, nên đặt gì ở
# đây cũng là no-op im lặng và dispatcher luôn chạy bằng default. Thêm biến DISPATCH_* mới thì
# phải thêm tên nó vào vòng lặp trong scripts/pod-bootstrap.sh, nếu không lỗi đó quay lại.
